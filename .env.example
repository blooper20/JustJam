# ==============================================================================
# JustJam Environment Variables Template
# Copy this file to '.env' and fill in the values.
# For production settings, refer to DEPLOYMENT.md.
# ==============================================================================

# 🌐 Application Environment
# Options: development, production, test
APP_ENV=development

# 🔑 Authentication & JWT Settings
# JWT_SECRET_KEY must be a random, cryptographically secure 32+ character string in production
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=justjam_development_secret_key_change_me_in_production_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 🗄️ Database Settings
# - SQLite (local dev default): Leave DATABASE_URL empty/commented out.
# - PostgreSQL (production/docker-compose): Set DATABASE_URL as shown below.
DATABASE_URL=postgresql://justjam:justjam@localhost:5432/justjam

# 🐳 Docker Compose Database Config (Only used for postgres container setup)
POSTGRES_USER=justjam
POSTGRES_PASSWORD=justjam
POSTGRES_DB=justjam

# 🧠 Redis Settings (Required for Celery background tasks & caching)
REDIS_URL=redis://localhost:6379/0

# 🚦 CORS Settings
# Comma-separated list of allowed origins.
# For production, include your Vercel frontend URL (e.g. https://justjam.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000,https://justjam.vercel.app

# 📈 Error Monitoring (Optional)
SENTRY_DSN=

# 💻 Next.js Frontend Configuration (Reference for Client Deployment)
# These should be configured in the Next.js client environment (.env.production / Vercel dashboard)
# NEXTAUTH_URL=http://localhost:3001
# NEXTAUTH_SECRET=vl4Y6cdSZyDyl3OngJQUxYn1Jtf5fxgX/7p4vA00yCE=
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SENTRY_DSN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

